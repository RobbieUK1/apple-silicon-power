[Unit]
Description=Apple Silicon 80 percent charge guard
After=systemd-udev-settle.service
ConditionPathExists=/sys/class/power_supply/macsmc-battery/charge_behaviour

[Service]
Type=simple
ExecStart=/usr/local/lib/apple-silicon-power/charge-guard.py daemon
ExecStopPost=/usr/local/lib/apple-silicon-power/charge-guard.py reset
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
User=root
RuntimeDirectory=apple-silicon-power
RuntimeDirectoryMode=0755
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/sys/class/power_supply/macsmc-battery/charge_behaviour
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
